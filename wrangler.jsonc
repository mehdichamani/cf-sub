{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cf-sub",
  "main": "src/index.ts",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "rules": [
    {
      "type": "Text",
      "globs": ["profiles/*.txt", "nodes/*.txt"],
      "fallthrough": true
    }
  ],
  "vars": {
    "SUB_NAME": "CF-V2Ray-Sub",
    "PROFILE_TITLE": "Cloudflare Worker V2Ray Subscription"
  }
}
